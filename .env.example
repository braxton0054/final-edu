# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mtandaolabsedu?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mtandaolabsedu?schema=public"

# Auth
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_NAME="MtandaoLabs EDU"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Root domain used to resolve school tenants (e.g. myschool.mtandaolabsedu.com).
TENANT_ROOT_DOMAIN="mtandaolabsedu.com"

# Shared secret for the scheduled trial-lifecycle cron endpoint.
CRON_SECRET=""

# Redis (worker / cache / queues)
REDIS_URL="redis://localhost:6379"

# Storage (S3 compatible)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="mtandaolabsedu"

# M-Pesa (Daraja sandbox defaults - per-school overrides in DB, encrypted)
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="http://localhost:3000/api/webhooks/mpesa"

# Email (SMTP defaults - per-school overrides in DB, encrypted)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@mtandaolabs.com"

# WhatsApp (Evolution API)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY=""

# ─── WhatsApp (Evolution API, internal service) ───
# Evolution runs inside this deployment on an internal/loopback port and is
# never exposed publicly. The SaaS backend is its only caller.
# Local dev (docker-compose.yml):       http://localhost:8080
# Production VPS (docker-compose.prod.yml): http://127.0.0.1:8080
EVOLUTION_API_URL="http://localhost:8080"
# Master key for Evolution (AUTHENTICATION_API_KEY). Never sent to browsers.
EVOLUTION_API_KEY=""
# Shared secret Evolution includes when calling our webhook back. Must match
# on both sides; generate with: openssl rand -hex 32
EVOLUTION_WEBHOOK_SECRET=""
# Internal base URL Evolution uses to reach this Next.js app (no public
# domain needed). IMPORTANT: from inside the Evolution container, 127.0.0.1
# means the container itself — always use host.docker.internal for the host:
#   Local dev (Next.js on host via pnpm dev):  http://host.docker.internal:3000
#   Production VPS (Next.js on systemd :8093): http://host.docker.internal:8093
EVOLUTION_WEBHOOK_URL="http://host.docker.internal:3000"

# Encryption for per-tenant secrets stored in DB
SECRETS_ENCRYPTION_KEY="generate-32-byte-hex-key-here"
